<?xml version="1.0"?>
<robot
    xmlns:xacro="http://www.ros.org/wiki/xacro" name="gimbalrotor" >
  <xacro:arg name="robot_name" default="gimbalrotor" />
  <xacro:arg name="enable_camera" default="false" />
  <xacro:property name="enable_camera" value="$(arg enable_camera)"/>

  <xacro:include filename="$(find gimbalrotor)/robots/beatle/visual_base.urdf.xacro" />

  <!-- gazebo plugin for default controller and sensors -->
  <xacro:include filename="$(find aerial_robot_simulation)/xacro/spinal.gazebo.xacro" />
  <xacro:gazebo_spinal robot_name="$(arg robot_name)" mag_frame="fc" />

  <gazebo reference="base_link">
    <visual>
      <plugin name="trajectory_visualizer" filename="libtrajectory_visualizer.so">
  	<pose_topic>/gimbalrotor/endeffector_pose</pose_topic>
      </plugin>
    </visual>
  </gazebo>

</robot>
