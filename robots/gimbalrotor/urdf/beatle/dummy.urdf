<?xml version="1.0"?>
<robot name="dummy">
  <link name="world"/>

  <link name="base_link">
    <!-- 見た目 -->
    <visual>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0 0 0 0"/>
      </material>
      <plugin name="trajectory_visualizer" filename="libtrajectory_visualizer.so">
	<pose_topic>/gimbalrotor/endeffector_pose</pose_topic>
      </plugin>
    </visual>

    <!-- 慣性（必須） -->
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0"/>
      <inertia
        ixx="0.001" ixy="0.0" ixz="0.0"
        iyy="0.001" iyz="0.0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- <gazebo reference="base_link"> -->
  <!--   <plugin name="trajectory_visualizer" filename="libtrajectory_visualizer.so"> -->
  <!--     <!-\- プラグイン固有パラメータ -\-> -->
  <!--     <color>1 0 0 1</color> -->
  <!--     <scale>1.0</scale> -->
  <!--   </plugin> -->
  <!-- </gazebo> -->
</robot>
